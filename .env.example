# Frontend values are public and must only contain Supabase publishable credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_URL=http://localhost:8787

# Server-only secrets belong in Cloudflare Worker secrets, never in VITE_* variables.
# SUPABASE_SECRET_KEY=
